{
  "manifest_version": 3,
  "name": "Beast Academy en français",
  "version": "0.1.2",
  "description": "Hover over Beast Academy lesson instructions and speech bubbles to read them in French.",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/baf-16.png",
    "32": "icons/baf-32.png",
    "48": "icons/baf-48.png",
    "128": "icons/baf-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Beast Academy en français",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/baf-16.png",
      "32": "icons/baf-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  }
}
